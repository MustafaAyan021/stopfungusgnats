---
import { Home, Search, ListChecks, CircleHelp } from "lucide-react";

const TABS = [
  { href: "/", label: "Home", icon: Home },
  { href: "/identify", label: "Identify", icon: Search },
  { href: "/plan", label: "Plan", icon: ListChecks },
  { href: "/faq", label: "FAQ", icon: CircleHelp },
] as const;

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-surface/90 backdrop-blur-md pb-[env(safe-area-inset-bottom)] md:hidden"
  aria-label="Primary"
>
  <div class="mx-auto flex max-w-6xl items-stretch">
    {
      TABS.map((tab) => {
        const active = isActive(tab.href);
        return (
          <a
            href={tab.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "focus-ring relative flex min-h-16 flex-1 flex-col items-center justify-center gap-1 transition-colors duration-[var(--motion-quick)]",
              active ? "text-primary" : "text-muted active:text-fg",
            ]}
          >
            {active && <span class="absolute inset-x-6 top-0 h-0.5 rounded-full bg-primary" />}
            <tab.icon className="size-6" strokeWidth={active ? 2.25 : 1.75} />
            <span class="label-mono text-[10px]">{tab.label}</span>
          </a>
        );
      })
    }
  </div>
</nav>
