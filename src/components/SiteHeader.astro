---
import { Sprout, Menu, X } from "lucide-react";
import { buttonVariants } from "@/lib/button-variants";
import { SITE } from "@/data/content";
import ThemeToggle from "@/components/ThemeToggle.astro";

const NAV = [
  { href: "/", label: "How to stop them" },
  { href: "/identify", label: "Identify" },
  { href: "/plan", label: "7-day plan" },
  { href: "/faq", label: "FAQ" },
] as const;

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="focus-ring flex items-center gap-2 rounded-md text-fg">
      <span
        class="flex size-9 items-center justify-center rounded-md bg-primary text-primary-foreground"
      >
        <Sprout className="size-4" strokeWidth={1.75} />
      </span>
      <span class="font-display text-lg tracking-tight">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "focus-ring relative rounded-md px-3 py-2 text-sm transition-colors duration-[var(--motion-quick)]",
              isActive(item.href)
                ? "text-fg font-medium"
                : "text-muted hover:bg-surface-2 hover:text-fg",
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-primary" />
            )}
          </a>
        ))
      }
      <div class="ml-2 flex items-center gap-2">
        <ThemeToggle />
        <a href="/plan" class={buttonVariants({ size: "sm" })}>Start the plan</a>
      </div>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        id="menu-toggle"
        class="focus-ring flex size-11 items-center justify-center rounded-md border border-border bg-surface"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Menu className="size-5" data-icon="open" />
        <X className="hidden size-5" data-icon="close" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="collapse border-t border-border bg-surface md:hidden">
    <div>
      <nav class="mx-auto flex max-w-6xl flex-col px-4 py-3" aria-label="Mobile">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "focus-ring flex min-h-11 items-center rounded-md px-2 text-base",
                isActive(item.href) ? "font-medium text-primary" : "text-fg",
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="/plan"
          class="mt-2 flex min-h-11 items-center justify-center rounded-md bg-primary text-primary-foreground transition-opacity hover:opacity-90"
        >
          Start the 7-day plan
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("mobile-nav");
  const openIcon = toggle?.querySelector<HTMLElement>('[data-icon="open"]');
  const closeIcon = toggle?.querySelector<HTMLElement>('[data-icon="close"]');

  function setOpen(isOpen: boolean) {
    nav?.classList.toggle("is-open", isOpen);
    toggle?.setAttribute("aria-expanded", String(isOpen));
    toggle?.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
    openIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  }

  toggle?.addEventListener("click", () => {
    setOpen(!nav?.classList.contains("is-open"));
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
