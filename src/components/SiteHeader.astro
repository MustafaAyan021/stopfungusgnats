---
import { Sprout } from "lucide-react";
import { buttonVariants } from "@/lib/button-variants";
import { SITE } from "@/data/content";
import ThemeToggle from "@/components/ThemeToggle.astro";

const NAV = [
  { href: "/how-to-get-rid-of-fungus-gnats", label: "Full guide" },
  { href: "/identify", label: "Identify" },
  { href: "/fungus-gnat-treatments", label: "Treatments" },
  { href: "/plan", label: "7-day plan" },
  { href: "/faq", label: "FAQ" },
  { href: "/about", label: "About" },
] as const;

const TICKER = [
  "EGGS HATCH IN DAYS",
  "MOST GNATS ARE GONE IN 7–10 DAYS",
  "DRY SOIL = NO NURSERY",
  "TRAP THE ADULTS",
  "KILL THE LARVAE",
  "STOP THE CYCLE",
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<div class="h-9 overflow-hidden border-b border-border bg-surface-2/80 backdrop-blur-md" aria-hidden="true">
  <div class="marquee-track h-9 items-center">
    {
      Array.from({ length: 2 }).map(() => (
        <div class="flex shrink-0 items-center">
          {TICKER.map((item) => (
            <span class="label-mono flex items-center gap-3 px-4 text-xs font-semibold text-fg">
              {item}
              <span class="text-primary">&bull;</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-border bg-bg/75 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="focus-ring flex items-center gap-2.5 rounded-md text-fg">
      <span
        class="flex size-10 rotate-[-4deg] items-center justify-center rounded-md border-2 border-ink bg-primary text-primary-foreground shadow-stamp-ink"
      >
        <Sprout className="size-5" strokeWidth={2} />
      </span>
      <span class="font-display text-xl font-semibold tracking-tight">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "label-mono focus-ring relative rounded-md px-3 py-2 text-xs transition-colors duration-[var(--motion-quick)]",
              isActive(item.href)
                ? "text-fg"
                : "text-muted hover:bg-surface-2 hover:text-fg",
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute inset-x-2.5 -bottom-px h-0.5 rounded-full bg-primary" />
            )}
          </a>
        ))
      }
      <div class="ml-3 flex items-center gap-2">
        <ThemeToggle />
        <a href="/plan" class={buttonVariants({ size: "sm" })}>Start the plan</a>
      </div>
    </nav>

    <div class="md:hidden">
      <ThemeToggle />
    </div>
  </div>
</header>
