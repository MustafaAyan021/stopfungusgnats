---
import { Sprout } from "lucide-react";
import { SITE } from "@/data/content";
---

<footer class="mt-16 border-t-2 border-ink bg-ink text-paper">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      <p class="flex items-center gap-2 font-display text-lg font-semibold">
        <span class="flex size-7 rotate-[-4deg] items-center justify-center rounded-md border-2 border-primary bg-primary/15 text-primary">
          <Sprout className="size-3.5" strokeWidth={2} />
        </span>
        {SITE.name}
      </p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-paper/60">
        A practical guide for houseplant owners who want fungus gnats gone — not another recycled
        pest article.
      </p>
    </div>
    <div>
      <p class="label-mono text-[11px] text-primary">Guides</p>
      <ul class="mt-3 space-y-2 text-sm text-paper/70">
        <li><a href="/" class="focus-ring rounded-sm hover:text-paper">How to get rid of fungus gnats</a></li>
        <li><a href="/identify" class="focus-ring rounded-sm hover:text-paper">Identify the pest</a></li>
        <li><a href="/plan" class="focus-ring rounded-sm hover:text-paper">7-day plan</a></li>
        <li><a href="/guides/mosquito-bits" class="focus-ring rounded-sm hover:text-paper">Mosquito Bits / Bti</a></li>
      </ul>
    </div>
    <div>
      <p class="label-mono text-[11px] text-primary">Note</p>
      <p class="mt-3 text-sm leading-relaxed text-paper/60">
        Educational houseplant care only. Follow product labels. If a plant is collapsing or pets
        eat treated mix, talk to a local nursery or vet.
      </p>
    </div>
  </div>
  <div class="border-t border-bg/15 px-4 py-4 text-center">
    <p class="label-mono text-[10px] text-paper/40">{SITE.tagline}</p>
  </div>
</footer>
