---
import { ChevronRight } from "lucide-react";

interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
const trail = [{ name: "Home", path: "/" }, ...items];
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
  <ol class="label-mono flex flex-wrap items-center gap-1.5 text-[11px] text-muted">
    {
      trail.map((crumb, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <ChevronRight className="size-3 shrink-0 text-subtle" />}
          {i === trail.length - 1 ? (
            <span aria-current="page" class="text-fg">
              {crumb.name}
            </span>
          ) : (
            <a href={crumb.path} class="focus-ring rounded-sm hover:text-fg">
              {crumb.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
