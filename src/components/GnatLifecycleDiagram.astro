---
---

<svg
  viewBox="0 0 400 340"
  class="w-full max-w-sm"
  role="img"
  aria-labelledby="gnat-diagram-title"
>
  <title id="gnat-diagram-title">
    Cross-section of a potted plant showing gnats laying eggs in wet soil, larvae feeding below
    the surface, and a sticky trap catching adults
  </title>

  <!-- leaves -->
  <g stroke="var(--color-primary)" stroke-width="6" stroke-linecap="round" fill="none">
    <path d="M200 92 C 170 60, 140 55, 118 70 C 130 96, 160 104, 200 92 Z" />
    <path d="M200 92 C 230 55, 265 50, 292 66 C 278 96, 244 106, 200 92 Z" />
    <path d="M200 92 C 194 48, 202 18, 222 2" />
  </g>
  <g fill="var(--color-primary)" opacity="0.9">
    <path d="M200 92 C 170 60, 140 55, 118 70 C 130 96, 160 104, 200 92 Z" />
    <path d="M200 92 C 230 55, 265 50, 292 66 C 278 96, 244 106, 200 92 Z" />
  </g>

  <!-- pot -->
  <path
    d="M130 190 L270 190 L250 300 L150 300 Z"
    fill="var(--color-bg)"
    stroke="var(--color-border)"
    stroke-width="3"
  />
  <rect x="122" y="176" width="156" height="20" rx="6" fill="var(--color-bg)" stroke="var(--color-border)" stroke-width="3" />

  <!-- soil, dry top / damp zone -->
  <path d="M138 196 L262 196 L262 204 L138 204 Z" fill="color-mix(in oklab, var(--color-fg) 22%, var(--color-bg))" />
  <path
    d="M138 204 L262 204 L254 236 L146 236 Z"
    fill="color-mix(in oklab, var(--color-fg) 40%, var(--color-bg))"
  />

  <!-- larvae in the damp zone -->
  <g stroke="var(--color-bg)" stroke-width="2.5" stroke-linecap="round" opacity="0.85">
    <path d="M168 216 q4 5 8 0" />
    <path d="M196 224 q4 5 8 0" />
    <path d="M226 214 q4 5 8 0" />
  </g>

  <!-- sticky trap card -->
  <line x1="252" y1="150" x2="252" y2="200" stroke="var(--color-border)" stroke-width="3" />
  <rect
    x="238"
    y="120"
    width="28"
    height="40"
    rx="2"
    fill="#e8c94a"
    stroke="color-mix(in oklab, var(--color-fg) 30%, transparent)"
    stroke-width="1.5"
  />
  <g fill="var(--color-fg)" opacity="0.55">
    <circle cx="246" cy="130" r="1.6" />
    <circle cx="258" cy="136" r="1.6" />
    <circle cx="250" cy="146" r="1.6" />
  </g>

  <!-- flying adults -->
  <g fill="var(--color-fg)" opacity="0.75">
    <g transform="translate(150 110)">
      <ellipse rx="3.4" ry="1.6" />
      <path d="M0 0 l-7 -4 M0 0 l-7 4" stroke="var(--color-fg)" stroke-width="1" opacity="0.5" fill="none" />
    </g>
    <g transform="translate(178 78)">
      <ellipse rx="3.4" ry="1.6" />
      <path d="M0 0 l-7 -4 M0 0 l-7 4" stroke="var(--color-fg)" stroke-width="1" opacity="0.5" fill="none" />
    </g>
    <g transform="translate(122 142)">
      <ellipse rx="3.4" ry="1.6" />
      <path d="M0 0 l-7 -4 M0 0 l-7 4" stroke="var(--color-fg)" stroke-width="1" opacity="0.5" fill="none" />
    </g>
  </g>

  <!-- labels -->
  <g font-family="var(--font-sans)" font-size="11" fill="var(--color-muted)">
    <text x="90" y="132">Adults</text>
    <text x="270" y="112">Trap</text>
    <text x="90" y="222">Larvae</text>
  </g>
</svg>
