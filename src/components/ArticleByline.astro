---
import { Clock } from "lucide-react";
import { LAST_UPDATED } from "@/data/content";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const reviewedDate = new Date(`${LAST_UPDATED}T00:00:00Z`).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<p class:list={["label-mono flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[11px] text-subtle", className]}>
  <Clock className="size-3.5 shrink-0" />
  <span>Written by Mustafa Ayan</span>
  <span aria-hidden="true">·</span>
  <span>Fact-checked against university extension/IPM sources</span>
  <span aria-hidden="true">·</span>
  <span>Last reviewed: {reviewedDate}</span>
</p>
