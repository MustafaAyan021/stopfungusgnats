---
import Layout from "@/layouts/Layout.astro";
import { PestIdentifier } from "@/components/PestIdentifier";
---

<Layout
  title="Identify Fungus Gnats vs Fruit Flies | Stop Fungus Gnats"
  description="Tell fungus gnats from fruit flies and drain flies in three questions so you treat the right pest."
>
  <main class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2">
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">Identify</p>
      <h1 class="mt-2 font-display text-4xl tracking-tight">Are these fungus gnats?</h1>
      <p class="mt-4 leading-relaxed text-muted">
        Fungus gnats are slender, dark, mosquito-like flies that hover over houseplant soil. They
        are weak fliers. Fruit flies prefer kitchens. Drain flies look moth-like and sit on
        porcelain.
      </p>
      <figure class="mt-6 overflow-hidden rounded-lg border border-border">
        <img
          src="/images/macro.jpg"
          alt="Macro photo of a fungus gnat on potting soil"
          class="aspect-4/3 w-full object-cover"
        />
      </figure>
      <ul class="mt-6 grid gap-3 text-sm leading-relaxed text-muted">
        <li>
          <span class="font-medium text-fg">Fungus gnats:</span> soil, long legs, fly up when you
          water.
        </li>
        <li>
          <span class="font-medium text-fg">Fruit flies:</span> fruit, trash, compost, rounder body,
          red eyes.
        </li>
        <li>
          <span class="font-medium text-fg">Drain flies:</span> drains, fuzzy wings, hop more than
          they fly.
        </li>
      </ul>
    </div>
    <PestIdentifier client:load />
  </main>
</Layout>
