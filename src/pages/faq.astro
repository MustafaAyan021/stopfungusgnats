---
import { ChevronDown } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import { FAQS } from "@/data/content";
---

<Layout
  title="Fungus Gnat FAQ | Stop Fungus Gnats"
  description="Do fungus gnats bite? How long to get rid of them? Is cinnamon enough? Answers for houseplant owners."
>
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">FAQ</p>
    <h1 class="mt-2 font-display text-4xl tracking-tight">Fungus gnat questions</h1>
    <div class="mt-8 divide-y divide-border border-y border-border">
      {
        FAQS.map((item) => (
          <details class="group py-4" open>
            <summary class="focus-ring flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-md font-medium [&::-webkit-details-marker]:hidden">
              {item.q}
              <ChevronDown className="size-4 shrink-0 text-muted transition-transform duration-[var(--motion-quick)] group-open:rotate-180" />
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </main>
</Layout>
