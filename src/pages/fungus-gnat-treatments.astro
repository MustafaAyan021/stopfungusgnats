---
import { ArrowRight } from "lucide-react";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ArticleByline from "@/components/ArticleByline.astro";
import { LAST_UPDATED, METHODS } from "@/data/content";
import { articleSchema, breadcrumbSchema, schemaGraph } from "@/lib/seo";

const PATH = "/fungus-gnat-treatments";
const TITLE = "Fungus Gnat Treatments: Every Method, Side by Side";
const DESCRIPTION =
  "Every legitimate fungus gnat treatment in one place — what each targets, how long it takes, and which guide to read next.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([{ name: "Treatments", path: PATH }]),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Treatments", path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Treatments</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          Every treatment, <span class="text-primary italic">side by side</span>
        </h1>
        <ArticleByline class="mt-3" />
        <p class="mt-4 max-w-2xl leading-relaxed text-muted">
          No single method finishes a fungus gnat infestation alone — each one below reaches a
          different stage of the <a href="/fungus-gnat-life-cycle" class="text-primary hover:underline">life cycle</a>. The
          <a href="/how-to-get-rid-of-fungus-gnats" class="text-primary hover:underline">full guide</a> explains
          how to stack them; each card here links to complete, step-by-step instructions.
        </p>
      </header>

      <section class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal>
        {
          METHODS.map((method) => (
            <a
              href={`/guides/${method.slug}`}
              class="focus-ring group overflow-hidden glass rounded-xl shadow-stamp transition-transform duration-[var(--motion-quick)] hover:-translate-y-1"
            >
              <div class="overflow-hidden border-b border-border/60">
                <Image
                  src={method.image}
                  alt={`${method.title} for fungus gnat control`}
                  class="aspect-video w-full object-cover transition-transform duration-500 ease-[var(--ease-out)] group-hover:scale-105"
                  widths={[400, 700]}
                  sizes="(min-width: 640px) 45vw, 100vw"
                  format="webp"
                  quality={72}
                  loading="lazy"
                />
              </div>
              <div class="p-5">
                <p class="label-mono text-[10px] text-primary">
                  {method.kicker} · {method.time}
                </p>
                <h2 class="mt-1 font-display text-xl font-semibold tracking-tight">{method.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">{method.summary}</p>
                <p class="mt-3 flex items-center gap-1.5 text-sm font-semibold text-primary">
                  Read the guide
                  <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
                </p>
              </div>
            </a>
          ))
        }
      </section>

      <section class="mt-12 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Not sure where to start?</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Start with identification, then manage moisture for that specific plant, then monitor
          with sticky traps — that alone resolves many light cases. Add a labeled Bti product if
          moisture control and traps aren't enough on their own. The
          <a href="/plan" class="text-primary hover:underline">7-day plan</a> turns that into a
          day-by-day checklist.
        </p>
      </section>
    </article>
  </main>
</Layout>
