---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import GnatLifecycleDiagram from "@/components/GnatLifecycleDiagram.astro";
import { LAST_UPDATED, LIFECYCLE_STAGES } from "@/data/content";
import { articleSchema, breadcrumbSchema, schemaGraph } from "@/lib/seo";

const PATH = "/fungus-gnat-life-cycle";
const TITLE = "Fungus Gnat Life Cycle: Egg to Adult, Explained";
const DESCRIPTION =
  "How long the fungus gnat life cycle takes indoors, what happens at each stage — egg, larva, pupa, adult — and which stage each treatment actually reaches.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([{ name: "Fungus Gnat Life Cycle", path: PATH }]),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Fungus Gnat Life Cycle", path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Identification</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          The fungus gnat <span class="text-primary italic">life cycle</span>
        </h1>
        <div class="glass mt-6 rounded-xl p-6 shadow-stamp">
          <p class="label-mono text-[11px] text-primary">Direct answer</p>
          <p class="mt-2 leading-relaxed">
            Indoors, a fungus gnat goes from egg to breeding adult in roughly
            <strong class="text-fg"> three to four weeks</strong> at typical room temperature —
            faster in a warm spot like near a heat vent or grow light, slower in a cool room, since
            development speed is temperature-dependent. Because a female lays a new
            batch of eggs within a day or two of emerging, generations overlap — new eggs, larvae,
            pupae, and adults are usually all present in an infested pot at once. That overlap is
            why a single treatment rarely ends an infestation, and why the
            <a href="/how-to-get-rid-of-fungus-gnats" class="text-primary hover:underline">full elimination plan</a> targets more than one stage at a time.
          </p>
        </div>
      </header>

      <section class="mt-10" data-reveal>
        <div class="glass rounded-xl p-4 shadow-stamp sm:p-7">
          <GnatLifecycleDiagram />
        </div>
      </section>

      <section class="mt-10 grid gap-5" data-reveal>
        {
          LIFECYCLE_STAGES.map((stage) => (
            <article class="glass rounded-xl p-5 shadow-stamp-sm sm:p-6">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="label-mono text-xs text-primary">{stage.n}</span>
                <h2 class="font-display text-xl font-semibold tracking-tight">{stage.stage}</h2>
                <span class="label-mono text-[11px] text-subtle">{stage.duration}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted">{stage.detail}</p>
            </article>
          ))
        }
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">
          Which treatment reaches which stage
        </h2>
        <p class="mt-3 leading-relaxed text-muted">
          Eggs and larvae live in the soil, where only appropriate moisture management or a
          labeled Bti product reaches them. Adults are the only stage sticky traps catch — which
          is also why traps alone, without a soil-directed treatment, only ever slow an
          infestation instead of ending it. Not sure what you're looking at underground? See
          <a href="/fungus-gnat-larvae" class="text-primary hover:underline">how to identify fungus gnat larvae</a>,
          or the full breakdown of <a href="/fungus-gnat-treatments" class="text-primary hover:underline">every treatment option</a>.
        </p>
        <a href="/how-to-get-rid-of-fungus-gnats" class="focus-ring group mt-6 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary">
          Back to the full elimination guide
          <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
        </a>
      </section>
    </article>
  </main>
</Layout>
