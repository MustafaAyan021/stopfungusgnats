---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ArticleByline from "@/components/ArticleByline.astro";
import { LAST_UPDATED, SOURCES } from "@/data/content";
import { articleSchema, breadcrumbSchema, schemaGraph } from "@/lib/seo";

const PATH = "/fungus-gnats-in-succulents";
const TITLE = "Fungus Gnats in Succulents and Cacti";
const DESCRIPTION =
  "Why fungus gnats are unusual in succulents and cacti, what it means when they show up anyway, and why the standard liquid-drench advice doesn't fit these plants.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([{ name: "Fungus Gnats in Succulents", path: PATH }]),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Fungus Gnats in Succulents", path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Plants</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          Fungus gnats in <span class="text-primary italic">succulents and cacti</span>
        </h1>
        <ArticleByline class="mt-3" />
        <div class="glass mt-6 rounded-xl p-6 shadow-stamp">
          <p class="label-mono text-[11px] text-primary">Direct answer</p>
          <p class="mt-2 leading-relaxed">
            Fungus gnats are genuinely uncommon in succulents and cacti, because their fast-draining
            mix and infrequent watering are inhospitable to gnat eggs and larvae in the first
            place. If you do see them here, it's a reliable signal that this particular pot is
            staying wetter than it should for that plant — fixing the mix and watering habit
            usually matters more than any larval treatment.
          </p>
        </div>
      </header>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Why this usually means something else is off</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Fungus gnat eggs and larvae need consistently moist organic matter to survive. A properly
          potted succulent or cactus — gritty, fast-draining mix, watered only when fully dry, in a
          pot with real drainage — simply doesn't offer that for long enough. Seeing gnats around
          one specifically usually points to one of a few common causes: a mix that's too
          peat-heavy for the plant, a pot with poor or blocked drainage, a saucer or cachepot
          holding water at the base, or a watering habit set for a different, thirstier plant
          nearby and applied here out of convenience.
        </p>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">What to fix, in order</h2>
        <ol class="relative mt-6 grid gap-5">
          <div class="absolute top-4 bottom-4 left-4.5 w-px bg-border" aria-hidden="true" />
          {
            [
              {
                title: "Empty any saucer or cachepot",
                body: "Standing water at the base defeats fast-draining mix entirely and is the single most common hidden cause.",
              },
              {
                title: "Check the pot actually drains",
                body: "A decorative pot with no drainage hole, or a nursery pot sitting too snugly inside one, can trap water against the roots even when the surface looks dry.",
              },
              {
                title: "Repot into a gritty, succulent-specific mix if it's peat-heavy",
                body: "Standard potting soil retains far more moisture than succulents and cacti need — mixing in perlite, pumice, or coarse sand changes how long it stays wet.",
              },
              {
                title: "Water on the plant's own schedule, not a shared one",
                body: "If this plant sits near thirstier houseplants and gets watered on the same pass, it's likely getting more than it needs.",
              },
            ].map((step, i) => (
              <li class="relative flex gap-4">
                <span class="relative z-10 flex size-9 shrink-0 items-center justify-center rounded-md border-2 border-ink bg-primary font-display text-sm font-bold text-primary-foreground tabular-nums">
                  {i + 1}
                </span>
                <div class="pt-1">
                  <h3 class="font-display text-lg font-semibold tracking-tight">{step.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Why a liquid drench is a poor fit here</h2>
        <p class="mt-3 leading-relaxed text-muted">
          The usual larval treatments — a Bti drench or an optional hydrogen peroxide drench — are
          both full watering events. Succulents and cacti are already more vulnerable to root rot
          from excess moisture than the gnats are a threat to them, so repeating a liquid drench on
          a plant like this can do more harm than the infestation itself. If larvae are confirmed
          and the moisture fixes above aren't enough, a light surface sprinkle of a Bti granule
          product (rather than a soaking drench) is a better-matched option — follow that product's
          label.
        </p>
        <a
          href="/guides/let-soil-dry"
          class="focus-ring group mt-6 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary"
        >
          Plant-specific drying guidance
          <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
        </a>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-xl font-semibold tracking-tight">Sources</h2>
        <ul class="mt-3 grid gap-1.5 text-sm">
          {
            SOURCES.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                  {source.label}
                </a>
                <span class="text-muted"> — {source.publisher}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </main>
</Layout>
