---
import Layout from "@/layouts/Layout.astro";
import { TreatmentPlan } from "@/components/TreatmentPlan";
---

<Layout
  title="7-Day Plan to Get Rid of Fungus Gnats | Stop Fungus Gnats"
  description="A day-by-day plan to get rid of fungus gnats: dry the mix, set sticky traps, treat larvae, and prevent the next wave."
>
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">Protocol</p>
    <h1 class="mt-2 font-display text-4xl tracking-tight">
      7-day plan to get rid of fungus gnats
    </h1>
    <p class="mt-4 leading-relaxed text-muted">
      Check off each task as you go. Progress stays on this device. Keep the dry-top habit for two
      weeks after day 7 even if the air looks clear.
    </p>
    <div class="mt-10">
      <TreatmentPlan client:load />
    </div>
  </main>
</Layout>
