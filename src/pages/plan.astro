---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { TreatmentPlan } from "@/components/TreatmentPlan";
import { PLAN_DAYS } from "@/data/content";
import { breadcrumbSchema, howToSchema, schemaGraph } from "@/lib/seo";

const PATH = "/plan";
const TITLE = "7-Day Plan to Get Rid of Fungus Gnats";
const DESCRIPTION = "A day-by-day plan to get rid of fungus gnats: dry the mix, set sticky traps, treat larvae, and prevent the next wave.";

const schema = schemaGraph(
  breadcrumbSchema([{ name: "7-Day Plan", path: PATH }]),
  howToSchema({
    name: TITLE,
    description: DESCRIPTION,
    path: PATH,
    totalTime: "P7D",
    steps: PLAN_DAYS.map((day) => ({
      name: `Day ${day.day}: ${day.title}`,
      text: day.tasks.join(" "),
    })),
  }),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]}>
  <Breadcrumbs items={[{ name: "7-Day Plan", path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-12 sm:px-6" data-reveal>
    <span class="label-mono inline-flex -rotate-2 items-center rounded-md border-2 border-ink bg-primary px-3 py-1.5 text-[11px] text-primary-foreground shadow-stamp-sm">
      The protocol
    </span>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
      Seven days. <span class="text-primary italic">One</span> checklist.
    </h1>
    <p class="mt-4 max-w-xl leading-relaxed text-muted">
      Check off each task as you go — your progress stays on this device. This covers the first
      week of a light-to-moderate infestation. A heavier, multi-plant infestation typically needs
      3–4 weeks total, so don't be surprised if you're still going after day 7 — that's normal, not
      a sign it isn't working. Keep the dry-top habit for two more weeks after the last adult you
      see, even if the air already looks clear. That's the step people skip, and the reason gnats
      come back.
    </p>
    <div class="mt-10">
      <TreatmentPlan client:idle />
    </div>
    <section class="mt-12 glass rounded-xl p-6 shadow-stamp-sm sm:p-7" data-reveal>
      <p class="label-mono text-[11px] text-primary">Still seeing adults after day 7?</p>
      <h2 class="mt-2 font-display text-xl font-semibold tracking-tight">Keep going into weeks 2–4</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        That's expected for a heavier infestation, not a failed plan. Repeat the larval drench
        (Bti or hydrogen peroxide) every 5–7 days, keep the top of every pot drying between
        waterings, and replace sticky cards as they fill. Stop counting from zero and start
        watching the trend on your traps — a falling count week over week means it's working, even
        before it hits zero.
      </p>
      <a
        href="/fungus-gnat-troubleshooting"
        class="focus-ring group mt-4 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary"
      >
        Troubleshoot a stalled infestation
      </a>
    </section>
  </main>
</Layout>
