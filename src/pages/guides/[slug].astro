---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ArticleByline from "@/components/ArticleByline.astro";
import { ArrowLeft } from "lucide-react";
import { GUIDES, LAST_UPDATED, METHODS } from "@/data/content";
import { articleSchema, breadcrumbSchema, schemaGraph } from "@/lib/seo";

export function getStaticPaths() {
  return Object.keys(GUIDES).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const guide = GUIDES[slug as string];
if (!guide) throw new Error(`No guide content for slug: ${slug}`);

const PATH = `/guides/${slug}`;
const others = METHODS.filter((m) => m.slug !== slug);

const PLANT_LINKS: Record<string, { to: string; label: string }[]> = {
  "let-soil-dry": [
    { to: "/fungus-gnats-in-seedlings", label: "Fungus gnats in seedlings" },
    { to: "/fungus-gnats-in-succulents", label: "Fungus gnats in succulents & cacti" },
  ],
  prevention: [{ to: "/new-plant-fungus-gnats", label: "Gnats after bringing home a new plant" }],
  "mosquito-bits": [{ to: "/fungus-gnat-larvae", label: "How to identify fungus gnat larvae" }],
};
const plantLinks = PLANT_LINKS[slug as string] ?? [];
const schema = schemaGraph(
  articleSchema({
    headline: guide.title,
    description: guide.description,
    path: PATH,
    image: guide.image.src,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([
    { name: "Treatments", path: "/fungus-gnat-treatments" },
    { name: guide.title, path: PATH },
  ]),
);
---

<Layout title={`${guide.title} | Stop Fungus Gnats`} description={guide.description} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Treatments", path: "/fungus-gnat-treatments" }, { name: guide.title, path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-12 sm:px-6" data-reveal>
    <a
      href="/fungus-gnat-treatments"
      class="focus-ring inline-flex min-h-11 items-center gap-2 rounded-md text-sm text-muted transition-colors duration-[var(--motion-quick)] hover:text-fg"
    >
      <ArrowLeft className="size-4" />
      All treatments
    </a>
    <span class="label-mono mt-6 inline-flex -rotate-1 items-center rounded-md border-2 border-ink bg-primary px-3 py-1.5 text-[11px] text-primary-foreground shadow-stamp-sm">
      {guide.kicker}
    </span>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight">{guide.title}</h1>
    <ArticleByline class="mt-3" />
    <p class="mt-4 text-lg leading-relaxed text-muted">{guide.description}</p>
    <figure class="mt-8 rotate-1 overflow-hidden rounded-xl border-2 border-ink shadow-stamp">
      <Image
        src={guide.image}
        alt={guide.title}
        class="aspect-video w-full object-cover"
        widths={[500, 900]}
        sizes="(min-width: 768px) 700px, 100vw"
        format="webp"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="mt-10 grid gap-10">
      {
        guide.body.map((section) => (
          <section>
            <h2 class="font-display text-2xl font-semibold tracking-tight">{section.heading}</h2>
            {section.paragraphs.map((p) => (
              <p class="mt-3 leading-relaxed text-muted">{p}</p>
            ))}
          </section>
        ))
      }
    </div>
    {
      plantLinks.length > 0 && (
        <aside class="mt-14 glass rounded-lg p-5 shadow-stamp-sm">
          <p class="label-mono text-[11px] text-primary">Specific to your plant</p>
          <ul class="mt-3 grid gap-2">
            {plantLinks.map((link) => (
              <li>
                <a
                  href={link.to}
                  class="focus-ring inline-flex rounded-sm text-sm font-medium hover:text-primary hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
    <aside class="mt-6 glass rounded-lg p-5 shadow-stamp-sm">
      <p class="label-mono text-[11px] text-primary">Next up</p>
      <ul class="mt-3 grid gap-2">
        {
          others.slice(0, 3).map((m) => (
            <li>
              <a
                href={`/guides/${m.slug}`}
                class="focus-ring inline-flex rounded-sm text-sm font-medium hover:text-primary hover:underline"
              >
                {m.title}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/how-to-get-rid-of-fungus-gnats"
            class="focus-ring inline-flex rounded-sm text-sm font-medium hover:text-primary hover:underline"
          >
            The full elimination guide
          </a>
        </li>
      </ul>
    </aside>
  </main>
</Layout>
