---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { LAST_UPDATED, PEST_COMPARISON } from "@/data/content";
import { articleSchema, breadcrumbSchema, schemaGraph } from "@/lib/seo";

const PATH = "/fungus-gnats-vs-fruit-flies";
const TITLE = "Fungus Gnats vs. Fruit Flies vs. Drain Flies";
const DESCRIPTION =
  "Tell fungus gnats apart from fruit flies and drain flies by look, behavior, and where they breed — so you treat the right pest the first time.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([{ name: "Fungus Gnats vs. Fruit Flies", path: PATH }]),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Fungus Gnats vs. Fruit Flies", path: PATH }]} />
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Identification</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          Fungus gnats vs. <span class="text-primary italic">fruit flies</span> vs. drain flies
        </h1>
        <div class="glass mt-6 rounded-xl p-6 shadow-stamp">
          <p class="label-mono text-[11px] text-primary">Direct answer</p>
          <p class="mt-2 leading-relaxed">
            Fungus gnats hover over houseplant soil and are dark with long, mosquito-like legs.
            Fruit flies are tan with red eyes and cluster around ripening produce or drains.
            Drain flies are fuzzy, moth-shaped, and sit still near sinks and floor drains. Where
            you find them, more than what they look like, is usually the fastest way to tell them
            apart.
          </p>
        </div>
      </header>

      <section class="mt-10" data-reveal>
        <div class="overflow-x-auto rounded-lg border-2 border-ink">
          <table class="w-full min-w-[640px] border-collapse text-sm">
            <thead>
              <tr class="border-b-2 border-ink bg-surface-2 text-left">
                <th scope="col" class="p-3 font-display font-semibold">Pest</th>
                <th scope="col" class="p-3 font-display font-semibold">Appearance</th>
                <th scope="col" class="p-3 font-display font-semibold">Behavior</th>
                <th scope="col" class="p-3 font-display font-semibold">Breeds in</th>
              </tr>
            </thead>
            <tbody>
              {
                PEST_COMPARISON.map((row) => (
                  <tr class="border-b border-border last:border-none align-top">
                    <td class="p-3 font-medium text-fg">{row.pest}</td>
                    <td class="p-3 text-muted">{row.body}</td>
                    <td class="p-3 text-muted">{row.behavior}</td>
                    <td class="p-3 text-muted">{row.breeds}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Why the distinction matters</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Fungus gnat treatments target moist soil and larvae underground — they won't touch a
          fruit fly problem coming from a bowl on the counter, and vice versa. Treating the wrong
          pest is one of the most common reasons a "fix" appears not to work. If you're still
          unsure, use the <a href="/identify" class="text-primary hover:underline">interactive identifier</a>, which
          walks through the same distinctions with your specific situation.
        </p>
        <a href="/how-to-get-rid-of-fungus-gnats" class="focus-ring group mt-6 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary">
          Confirmed it's fungus gnats? Start the full guide
          <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
        </a>
      </section>
    </article>
  </main>
</Layout>
