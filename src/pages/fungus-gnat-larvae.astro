---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ArticleByline from "@/components/ArticleByline.astro";
import { LAST_UPDATED, SOURCES } from "@/data/content";
import { articleSchema, breadcrumbSchema, schemaGraph } from "@/lib/seo";

const PATH = "/fungus-gnat-larvae";
const TITLE = "How to Identify Fungus Gnat Larvae";
const DESCRIPTION =
  "What fungus gnat larvae actually look like in potting soil, how to find them, how they differ from other soil larvae, and what finding them means for treatment.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([{ name: "Fungus Gnat Larvae", path: PATH }]),
);

const TRAITS = [
  { label: "Body", detail: "Legless, translucent to whitish, worm-like — you can often see the gut contents through the skin." },
  { label: "Head", detail: "A small, shiny black head capsule — the clearest visual difference from most other soil-dwelling larvae." },
  { label: "Size", detail: "Up to about 1/4 inch (6mm) long when mature — easy to miss without deliberately looking." },
  { label: "Location", detail: "In the top inch or two of moist potting mix, rarely on the surface unless the mix is disturbed." },
];

const LOOKALIKES = [
  {
    name: "Fruit fly larvae",
    detail: "Found in rotting fruit or drain sludge, not potting soil — pale, also legless, but you won't find them in a houseplant's mix unless something organic is decomposing directly in it.",
  },
  {
    name: "Springtails",
    detail: "Visible on the soil surface, not just underground, and they jump when disturbed rather than lying still. No black head capsule.",
  },
  {
    name: "Beneficial soil mites",
    detail: "Tiny, often pale or brown, with visible legs (larvae have none) — usually harmless and unrelated to a gnat problem.",
  },
];
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Fungus Gnat Larvae", path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Identification</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          What fungus gnat <span class="text-primary italic">larvae</span> look like
        </h1>
        <ArticleByline class="mt-3" />
        <div class="glass mt-6 rounded-xl p-6 shadow-stamp">
          <p class="label-mono text-[11px] text-primary">Direct answer</p>
          <p class="mt-2 leading-relaxed">
            Fungus gnat larvae are thin, legless, translucent-white worms up to about 1/4 inch
            long with a distinct shiny black head capsule, living in the top inch or two of moist
            potting mix. They're the stage doing the actual feeding — on fungi, decaying organic
            matter, and sometimes fine root hairs — while the adults you see flying are just the
            visible symptom.
          </p>
        </div>
      </header>

      <section class="mt-10 grid gap-4" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Identifying traits</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {
            TRAITS.map((trait) => (
              <div class="glass rounded-lg p-4 shadow-stamp-sm">
                <p class="label-mono text-[11px] text-primary">{trait.label}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{trait.detail}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">How to actually find them</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Larvae live below the surface, so casual glancing usually won't turn them up. The
          reliable way to check is the potato test: bury a half-inch cube of raw potato just under
          the soil surface and check the underside after 1–2 days. Larvae are drawn to it and
          should be visible if present. You can also gently scrape back the top half-inch of mix
          near the pot's edge and look directly, though this disturbs the plant more.
        </p>
        <p class="mt-3 leading-relaxed text-muted">
          Repeatedly finding no larvae is a useful sign the population may be declining, but a
          single clean check doesn't prove the pot is pest-free — treat it as one data point
          alongside trap counts, not a final verdict.
        </p>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Easy to confuse with</h2>
        <div class="mt-4 grid gap-3">
          {
            LOOKALIKES.map((item) => (
              <div class="glass rounded-lg p-4 shadow-stamp-sm">
                <p class="font-medium text-fg">{item.name}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.detail}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">What finding larvae means</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Confirmed larvae mean the soil-directed part of treatment matters, not just trapping
          adults — moisture management first, and a labeled Bti product if that's not enough on
          its own. Mature plants usually tolerate light larval feeding without much visible
          damage; seedlings and cuttings with small root systems are more vulnerable, so treat
          larvae confirmation in those pots as a reason to act promptly rather than wait and see.
        </p>
        <a
          href="/how-to-get-rid-of-fungus-gnats"
          class="focus-ring group mt-6 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary"
        >
          Go to the full elimination guide
          <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
        </a>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-xl font-semibold tracking-tight">Sources</h2>
        <ul class="mt-3 grid gap-1.5 text-sm">
          {
            SOURCES.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                  {source.label}
                </a>
                <span class="text-muted"> — {source.publisher}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </main>
</Layout>
