---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { CAUSES, LAST_UPDATED } from "@/data/content";
import { articleSchema, breadcrumbSchema, schemaGraph } from "@/lib/seo";

const PATH = "/why-do-i-have-fungus-gnats";
const TITLE = "Why Do I Have Fungus Gnats?";
const DESCRIPTION =
  "The real reasons fungus gnats show up indoors — wet soil, organic matter, new plants, standing water — and which ones apply to your home.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([{ name: "Why Do I Have Fungus Gnats?", path: PATH }]),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Why Do I Have Fungus Gnats?", path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Causes</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          Why do I have <span class="text-primary italic">fungus gnats?</span>
        </h1>
        <div class="glass mt-6 rounded-xl p-6 shadow-stamp">
          <p class="label-mono text-[11px] text-primary">Direct answer</p>
          <p class="mt-2 leading-relaxed">
            Fungus gnats show up because something in your home offers moist, organic soil for
            long enough to complete a life cycle — usually overwatering, a moisture-retentive
            mix, a new plant that arrived already infested, or a saucer that never fully drains.
            Fix the moisture and you remove the reason they're there at all.
          </p>
        </div>
      </header>

      <section class="mt-10 grid gap-4" data-reveal>
        {
          CAUSES.map((cause, i) => (
            <article class="glass rounded-xl p-5 shadow-stamp-sm sm:p-6">
              <span class="label-mono text-xs text-primary">{String(i + 1).padStart(2, "0")}</span>
              <h2 class="mt-1 font-display text-xl font-semibold tracking-tight">{cause.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">{cause.detail}</p>
            </article>
          ))
        }
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Once you know why, fix it</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Identifying the cause tells you which habit to change — the treatment itself is the same
          three-part process either way: dry the soil, trap the adults, kill the larvae.
        </p>
        <a href="/how-to-get-rid-of-fungus-gnats" class="focus-ring group mt-6 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary">
          Get the full elimination guide
          <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
        </a>
      </section>
    </article>
  </main>
</Layout>
