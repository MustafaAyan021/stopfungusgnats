---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ArticleByline from "@/components/ArticleByline.astro";
import DirectAnswer from "@/components/DirectAnswer.astro";
import { CAUSES } from "@/data/content";
import { articleSchema, pageDatesFor, breadcrumbSchema, schemaGraph } from "@/lib/seo";

const PATH = "/why-do-i-have-fungus-gnats";
const TITLE = "Where Do Fungus Gnats Come From? Why You Have Them";
const DESCRIPTION =
  "Where do fungus gnats come from? Wet soil, decaying organic matter, new plants, bagged mix, and standing water: the real reasons they show up indoors.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    ...pageDatesFor(PATH),
  }),
  breadcrumbSchema([{ name: "Why Do I Have Fungus Gnats?", path: PATH }]),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Why Do I Have Fungus Gnats?", path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Causes</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          Where do <span class="text-primary italic">fungus gnats</span> come from?
        </h1>
        <ArticleByline class="mt-3" />
        <DirectAnswer>
          Fungus gnats appear when your home offers moist organic material long enough to complete a life cycle. The most common sources are overwatered or moisture-retentive potting mix, a new plant that arrived infested, or a saucer that never drains. Fix the moisture at the source and you remove the reason they're there.
          <Fragment slot="more">Potting mix is the usual source, but they can occasionally breed in other damp organic sites too, including drains with a buildup of debris.</Fragment>
        </DirectAnswer>
      </header>

      <section class="mt-10 grid gap-4" data-reveal>
        {
          CAUSES.map((cause, i) => (
            <article class="glass rounded-xl p-5 shadow-stamp-sm sm:p-6">
              <span class="label-mono text-xs text-primary">{String(i + 1).padStart(2, "0")}</span>
              <h2 class="mt-1 font-display text-xl font-semibold tracking-tight">{cause.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">{cause.detail}</p>
            </article>
          ))
        }
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Once you know why, fix it</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Identifying the cause tells you which habit to change. If the cause was a recent
          arrival, see <a href="/new-plant-fungus-gnats" class="text-primary hover:underline">what to do after a new plant</a>.
          Otherwise, the treatment itself is the same process either way: confirm the pest, manage
          moisture, trap the adults, and treat larvae if needed.
        </p>
        <a href="/how-to-get-rid-of-fungus-gnats" class="focus-ring group mt-6 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary">
          Get the full elimination guide
          <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
        </a>
      </section>
    </article>
  </main>
</Layout>
