---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { LAST_UPDATED, TROUBLESHOOTING } from "@/data/content";
import { articleSchema, breadcrumbSchema, faqSchema, schemaGraph } from "@/lib/seo";

const PATH = "/fungus-gnat-troubleshooting";
const TITLE = "Fungus Gnat Troubleshooting: When the Plan Isn't Working";
const DESCRIPTION =
  "Why fungus gnats keep coming back, why sticky traps stop catching, how long treatment should realistically take, and what to do about a severe infestation.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([{ name: "Troubleshooting", path: PATH }]),
  faqSchema(TROUBLESHOOTING),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Troubleshooting", path: PATH }]} />
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Troubleshooting</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          When the plan <span class="text-primary italic">isn't working</span>
        </h1>
        <p class="mt-4 max-w-2xl leading-relaxed text-muted">
          Most "this doesn't work" reports trace back to one of a handful of causes. Find your
          situation below.
        </p>
      </header>

      <section class="mt-10 grid gap-4" data-reveal>
        {
          TROUBLESHOOTING.map((item) => (
            <div class="glass rounded-xl p-5 shadow-stamp-sm sm:p-6">
              <h2 class="font-display text-lg font-semibold tracking-tight">{item.q}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.a}</p>
            </div>
          ))
        }
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <p class="leading-relaxed text-muted">
          Still stuck after two full weeks of consistent treatment? Re-check the basics with the{" "}
          <a href="/how-to-get-rid-of-fungus-gnats" class="text-primary hover:underline">full elimination guide</a>{" "}
          — a wrong diagnosis or a missed second pot is behind most infestations that won't quit.
        </p>
        <a href="/plan" class="focus-ring group mt-6 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary">
          Restart with the 7-day plan
          <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
        </a>
      </section>
    </article>
  </main>
</Layout>
