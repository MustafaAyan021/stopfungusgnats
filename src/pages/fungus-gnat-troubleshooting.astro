---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ArticleByline from "@/components/ArticleByline.astro";
import { TroubleshootChecker } from "@/components/TroubleshootChecker";
import { LAST_UPDATED, TROUBLESHOOTING } from "@/data/content";
import { articleSchema, breadcrumbSchema, faqSchema, schemaGraph } from "@/lib/seo";

const PATH = "/fungus-gnat-troubleshooting";
const TITLE = "Fungus Gnats Won't Go Away? Troubleshooting When the Plan Isn't Working";
const DESCRIPTION =
  "Fungus gnats won't go away? Run the self-check to find the actual cause — why they keep coming back, why sticky traps stop catching, and what to do about a severe or stalled infestation.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([{ name: "Troubleshooting", path: PATH }]),
  faqSchema(TROUBLESHOOTING),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "Troubleshooting", path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Troubleshooting</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          Fungus gnats <span class="text-primary italic">won't go away</span>?
        </h1>
        <ArticleByline class="mt-3" />
        <p class="mt-4 max-w-2xl leading-relaxed text-muted">
          Most "this doesn't work" reports trace back to one of a handful of causes. Run the
          self-check below, or scan the situations underneath it.
        </p>
      </header>

      <section class="mt-10" data-reveal>
        <TroubleshootChecker client:visible />
      </section>

      <section class="mt-10 grid gap-4 border-t border-border pt-10" data-reveal>
        <h2 class="font-display text-lg font-semibold tracking-tight text-muted">
          Or find your exact situation
        </h2>
        {
          TROUBLESHOOTING.map((item) => (
            <div class="glass rounded-xl p-5 shadow-stamp-sm sm:p-6">
              <h2 class="font-display text-lg font-semibold tracking-tight">{item.q}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.a}</p>
            </div>
          ))
        }
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <p class="leading-relaxed text-muted">
          Still stuck after two full weeks of consistent treatment? Re-check the basics with the{" "}
          <a href="/how-to-get-rid-of-fungus-gnats" class="text-primary hover:underline">full elimination guide</a>{" "}
          — a wrong diagnosis or a missed second pot is behind most infestations that won't quit.
          Not sure if it's actually working or genuinely stalled? See{" "}
          <a href="/how-to-know-treatment-is-working" class="text-primary hover:underline">how to know treatment is working</a>,
          or confirm what's in the soil with the{" "}
          <a href="/fungus-gnat-larvae" class="text-primary hover:underline">larvae identification guide</a>.
        </p>
        <a href="/plan" class="focus-ring group mt-6 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary">
          Restart with the 7-day plan
          <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
        </a>
      </section>
    </article>
  </main>
</Layout>
