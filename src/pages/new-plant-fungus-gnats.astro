---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { LAST_UPDATED, SOURCES } from "@/data/content";
import { articleSchema, breadcrumbSchema, schemaGraph } from "@/lib/seo";

const PATH = "/new-plant-fungus-gnats";
const TITLE = "Fungus Gnats After Bringing Home a New Plant";
const DESCRIPTION =
  "Why a new plant is one of the most common ways fungus gnats arrive, how to quarantine one properly, and what to do if gnats already showed up.";

const schema = schemaGraph(
  articleSchema({
    headline: TITLE,
    description: DESCRIPTION,
    path: PATH,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
  }),
  breadcrumbSchema([{ name: "New Plant, Fungus Gnats", path: PATH }]),
);
---

<Layout title={`${TITLE} | Stop Fungus Gnats`} description={DESCRIPTION} schema={[schema]} ogType="article">
  <Breadcrumbs items={[{ name: "New Plant, Fungus Gnats", path: PATH }]} />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <article>
      <header data-reveal>
        <p class="label-mono text-[11px] text-muted">Prevention</p>
        <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          Gnats showed up after a <span class="text-primary italic">new plant</span>?
        </h1>
        <div class="glass mt-6 rounded-xl p-6 shadow-stamp">
          <p class="label-mono text-[11px] text-primary">Direct answer</p>
          <p class="mt-2 leading-relaxed">
            A new plant is one of the most common ways fungus gnats enter a home — eggs or larvae
            can already be present in nursery mix or bagged potting soil that was stored somewhere
            damp, arriving before you ever see an adult fly. If gnats appeared within a week or two
            of a new arrival, that plant's mix is the most likely source, not the rest of your
            collection.
          </p>
        </div>
      </header>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">If gnats have already appeared</h2>
        <ol class="relative mt-6 grid gap-5">
          <div class="absolute top-4 bottom-4 left-4.5 w-px bg-border" aria-hidden="true" />
          {
            [
              {
                title: "Move the new plant away from others",
                body: "Adults wander freely between nearby pots. Isolating the likely source slows how fast it spreads while you treat it.",
              },
              {
                title: "Set a sticky card in that pot specifically",
                body: "This tells you whether the new plant is really the source, or whether an existing plant was already harboring a smaller population.",
              },
              {
                title: "Check and adjust the mix's moisture",
                body: "Nursery mix is often kept wetter than houseplants need long-term — let it dry appropriately for that plant type before resuming a normal watering routine.",
              },
              {
                title: "Follow the standard elimination steps if it's confirmed",
                body: "Once you're sure this plant is the source, treat it like any other infestation — traps, moisture control, and a labeled Bti product if needed.",
              },
            ].map((step, i) => (
              <li class="relative flex gap-4">
                <span class="relative z-10 flex size-9 shrink-0 items-center justify-center rounded-md border-2 border-ink bg-primary font-display text-sm font-bold text-primary-foreground tabular-nums">
                  {i + 1}
                </span>
                <div class="pt-1">
                  <h3 class="font-display text-lg font-semibold tracking-tight">{step.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-2xl font-semibold tracking-tight">Quarantine, for next time</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Keep a new plant away from your existing collection for about a week, with its own
          sticky card at soil level. If the card stays clean and the soil dries at a normal rate
          for that plant, it's reasonable to let it join the rest of the shelf. This single habit
          is one of the more effective, lowest-effort ways to avoid reintroducing an infestation
          you already cleared, or starting a new one from a fresh source.
        </p>
        <p class="mt-3 leading-relaxed text-muted">
          The same logic applies to bagged potting soil: if a bag was stored somewhere damp
          (a garage, a shed, a warm stockroom) before you bought it, treat it with the same
          suspicion as a new plant rather than assuming sealed packaging means sterile.
        </p>
        <a
          href="/guides/prevention"
          class="focus-ring group mt-6 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary"
        >
          Full prevention guide
          <ArrowRight className="size-4 transition-transform duration-[var(--motion-quick)] group-hover:translate-x-0.5" />
        </a>
      </section>

      <section class="mt-10 border-t border-border pt-8" data-reveal>
        <h2 class="font-display text-xl font-semibold tracking-tight">Sources</h2>
        <ul class="mt-3 grid gap-1.5 text-sm">
          {
            SOURCES.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                  {source.label}
                </a>
                <span class="text-muted"> — {source.publisher}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </main>
</Layout>
