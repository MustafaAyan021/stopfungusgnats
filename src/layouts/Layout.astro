---
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import MobileBottomNav from "@/components/MobileBottomNav.astro";
import { organizationSchema, websiteSchema, schemaGraph } from "@/lib/seo";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD nodes (breadcrumbs, Article, FAQPage, HowTo…) merged into the page's @graph. */
  schema?: object[];
  /** Override the canonical/OG path when it differs from the request path (rare). */
  canonicalPath?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description,
  schema = [],
  canonicalPath,
  ogImage = "/og.jpg",
  ogType = "website",
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
// Each page-level `schema` entry may itself be a full {@context,@graph} document
// (built with schemaGraph()) — flatten those into one top-level @graph instead of nesting.
const extraNodes = schema.flatMap((node: any) => (node && Array.isArray(node["@graph"]) ? node["@graph"] : [node]));
const jsonLd = schemaGraph(organizationSchema(), websiteSchema(), ...extraNodes);
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#f4efe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12150f" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("sfg-theme");
        var theme = stored === "light" || stored === "dark" ? stored : null;
        if (!theme) {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      // Only the weights actually used sitewide: Figtree 400/500/600, Fraunces 600/700
      // (+ italic 600), JetBrains Mono 500/700 — trimmed from the full default weight
      // ramp to cut webfont payload. Loaded non-render-blocking (media swap trick):
      // first paint uses the fallback stack, then swaps in once the CSS arrives.
    }
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&family=JetBrains+Mono:wght@500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&family=JetBrains+Mono:wght@500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&family=JetBrains+Mono:wght@500;700&display=swap"
      />
    </noscript>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Stop Fungus Gnats" />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#main-content"
      class="focus-ring sr-only rounded-md border-2 border-ink bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
      data-print-hide
    >
      Skip to content
    </a>
    <div class="min-h-screen bg-bg pb-[calc(4rem+env(safe-area-inset-bottom))] text-fg md:pb-0">
      <SiteHeader />
      <slot />
      <SiteFooter />
    </div>
    <MobileBottomNav />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
